# Generate a password with: openssl rand -hex 32
# Use hexadecimal characters here so DATABASE_URL needs no URL escaping.
POSTGRES_PASSWORD=
# Required on first start: admin password (at least 10 characters, at most 72 UTF-8 bytes).
# On later starts, leave blank to keep it or set a new value to rotate it.
ADMIN_PASSWORD=
PORT=8080
# Keep true behind HTTPS. For localhost HTTP development only, use false.
COOKIE_SECURE=true
# Optional comma-separated public origins, e.g. https://bills.example.com
ALLOWED_ORIGINS=
