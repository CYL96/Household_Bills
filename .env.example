# Generate a password with: openssl rand -hex 32
# Use hexadecimal characters here so DATABASE_URL needs no URL escaping.
POSTGRES_PASSWORD=
# Required on first start: admin password (at least 10 characters, at most 72 UTF-8 bytes).
# On later starts, leave blank to keep it or set a new value to rotate it.
ADMIN_PASSWORD=
PORT=8080
# Keep true behind HTTPS. For localhost HTTP development only, use false.
COOKIE_SECURE=true
# Optional comma-separated public origins, e.g. https://bills.example.com
ALLOWED_ORIGINS=
# Android app update publication.
# Gradle :app:publishRelease writes latest.json plus the signed APK into ANDROID_RELEASE_DIR.
# Default: android/release (relative values are resolved from the android/ project root).
# Docker Compose mounts a HOST directory read-only at the fixed container path
# /app/android-release; ANDROID_RELEASE_HOST_DIR selects that host directory.
# Do not set ANDROID_RELEASE_DIR to the container path: the image fixes it at /app/android-release.
# Prefer an absolute host path when customizing so Gradle and Compose resolve the same directory.
ANDROID_RELEASE_HOST_DIR=./android/release
